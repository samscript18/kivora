NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/kivora
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=https://api.example.com
PRIVY_APP_ID=
PRIVY_APP_SECRET=
KIVORA_APPROVAL_TOKEN=
WHEELHOUSE_API_KEY=
# Generate once with: openssl rand -hex 32
WHEELHOUSE_CREDENTIAL_ENCRYPTION_KEY=
WHEELHOUSE_BASE_URL=https://api.usewheelhouse.com/ss_api/v1
# Shared GET cache. Redis prevents repeated portfolio reads across API instances.
REDIS_URL=redis://localhost:6379
WHEELHOUSE_CACHE_TTL_SECONDS=300
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# AI provider failover order: Groq → Gemini → OpenRouter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small-2603
OPENROUTER_SITE_URL=
# SMTP service credentials for secure teammate invitations (for example Gmail).
MAILER_SERVICE=
MAILER_USER=
MAILER_PASS=
MAILER_FROM_EMAIL=Kivora <team@example.com>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Kivora
BREVO_API_URL=https://api.brevo.com/v3
TICKETMASTER_API_KEY=
OPENWEATHER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_SECRET=
SCAN_BATCH_SIZE=10
SCAN_INTERVAL_SECONDS=120
REPORT_STORAGE_PATH=./storage/reports
